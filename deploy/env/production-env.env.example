# production-env.env.example
# 用途：可直接被 systemd `EnvironmentFile=` 引用的生产环境变量示例。
# 用法：复制为 /etc/vllm/production-env.env，在 unit 里加一行
#       EnvironmentFile=-/etc/vllm/production-env.env
# 注意：systemd EnvironmentFile 不支持 shell 展开与命令替换，只能是 KEY=VALUE；
#       值中含空格时必须用双引号包裹（例如 WARMUP_SIZES）。
# 本文件全部为占位符，填入真实值前请勿提交到版本库。

# ---- 基础运行环境 -----------------------------------------------------------
HOME=<HOME_DIR>
LANG=<LOCALE>
LANGUAGE=<LANGUAGE_CHAIN>
XDG_DATA_DIRS=<XDG_DATA_DIRS>
PATH=<VENV_BIN>:<CUDA_BIN>:<LOCAL_BIN>:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ---- CUDA 工具链 ------------------------------------------------------------
CUDACXX=<CUDA_HOME>/bin/nvcc
CUDA_HOME=<CUDA_HOME>
CUDA_PATH=<CUDA_HOME>
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=<GPU_LIST>

# ---- 模型与依赖路径 ---------------------------------------------------------
MODEL_PATH=<MODEL_DIR>
VENV_PYTHON=<VENV_BIN>/python
FLASHQLA_ROOT=<PROJECT_DIR>/.deps/FlashQLA-SM70-SM75
PYTHONPATH=<PROJECT_DIR>:<PROJECT_DIR>/.deps/FlashQLA-SM70-SM75
PYTHONSAFEPATH=1
PYTHONUNBUFFERED=1

# ---- 编译缓存与架构 ---------------------------------------------------------
TORCH_CUDA_ARCH_LIST=<ARCH_LIST>
TORCH_EXTENSIONS_DIR=<CACHE_DIR>/torch_extensions
TORCHINDUCTOR_CACHE_DIR=<CACHE_DIR>/torchinductor
TRITON_CACHE_DIR=<CACHE_DIR>/triton

# ---- FlashInfer -------------------------------------------------------------
FLASHINFER_ENABLE_AOT=1
FLASHINFER_WORKSPACE_BASE=<PROJECT_DIR>

# ---- vLLM 行为开关 ----------------------------------------------------------
VLLM_DISABLE_TILELANG=<0_OR_1>
VLLM_SM75_SPEC_SYNC_MODE=<safe_or_fast>
VLLM_KV_CACHE_LAYOUT=<KV_LAYOUT>
VLLM_ALLOW_MAMBA_SPEC_FULL_CUDAGRAPH=<0_OR_1>
VLLM_ENFORCE_STRICT_TOOL_CALLING=<0_OR_1>
VLLM_KV_BUDGET_FROM_FREE_MEMORY=<0_OR_1>
VLLM_MARLIN_USE_ATOMIC_ADD=<0_OR_1>
VLLM_KV_BUDGET_REDUNDANCY_MIB=<MIB>

# ---- 服务端点 ---------------------------------------------------------------
VLLM_HOST=<BIND_ADDR>
VLLM_PORT=<PORT>
VLLM_SERVED_MODEL_NAME=<SERVED_MODEL_NAME>

# ---- 预热（vllm-warmup）-----------------------------------------------------
WARMUP_BASE=http://<BIND_ADDR>:<PORT>
WARMUP_MODEL=<SERVED_MODEL_NAME>
WARMUP_PY=<VENV_BIN>/python
WARMUP_SIZES="<CTX_1> <CTX_2> <CTX_3> <CTX_4>"

# ---- WorkBuddy 前缀缓存预热 -------------------------------------------------
WB_WARMUP_BASE=http://<BIND_ADDR>:<PORT>
WB_WARMUP_MODEL=<SERVED_MODEL_NAME>
WB_WARMUP_PAYLOAD=<PAYLOAD_JSON_PATH>
WB_WARMUP_PY=<VENV_BIN>/python

# ---- GPU 功耗与风扇 ---------------------------------------------------------
GPU_POWER_LIMIT_W=<WATTS>
FAN_DISPLAY=<DISPLAY_ID>
FAN_INTERVAL=<SECONDS>

# ---- 模型下载镜像 -----------------------------------------------------------
HF_ENDPOINT=<HF_MIRROR_URL>

# ---- 凭证占位（本机当前未使用；如启用请填真实值）----------------------------
# HF_TOKEN=<TOKEN>
# VLLM_API_KEY=<TOKEN>
