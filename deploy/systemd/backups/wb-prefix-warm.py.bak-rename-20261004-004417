#!/usr/bin/env python3
"""WorkBuddy prefix-cache warmup.

Reads a captured WorkBuddy /v1/chat/completions payload and replays ONLY the
cacheable prefix (system message + tools) so that vLLM's prefix cache is
pre-populated. The next real WorkBuddy request then skips the 43K-token cold
prefill.
"""
import json
import os
import sys
import time

import requests

BASE = os.environ.get("WB_WARMUP_BASE", "http://127.0.0.1:8000")
MODEL = os.environ.get("WB_WARMUP_MODEL", "Qwen3.8-27B-Uncensored-NVFP4")
PAYLOAD = os.environ.get("WB_WARMUP_PAYLOAD", "/root/wb_warmup_payload.json")
DUMMY = os.environ.get("WB_WARMUP_DUMMY", "warm")


def main():
    if not os.path.exists(PAYLOAD):
        print("warmup: no payload at %s" % PAYLOAD, flush=True)
        return 1
    with open(PAYLOAD, encoding="utf-8") as fh:
        src = json.load(fh)

    system_msgs = [m for m in (src.get("messages") or []) if m.get("role") == "system"]
    if not system_msgs:
        print("warmup: payload has no system message", flush=True)
        return 1

    body = dict(src)
    body["messages"] = system_msgs + [{"role": "user", "content": DUMMY}]
    body["stream"] = False
    body.pop("stream_options", None)
    body["max_tokens"] = 1
    body["temperature"] = 0.0
    body.setdefault("model", MODEL)

    t0 = time.time()
    try:
        r = requests.post(BASE + "/v1/chat/completions", json=body, timeout=1800)
    except Exception as exc:  # noqa: BLE001
        print("warmup: request failed: %s" % exc, flush=True)
        return 1
    if r.status_code != 200:
        print("warmup: HTTP %s %s" % (r.status_code, r.text[:300]), flush=True)
        return 1
    usage = (r.json() or {}).get("usage") or {}
    det = usage.get("prompt_tokens_details") or {}
    print(
        "warmup: ok in %.1fs prompt=%s cached=%s created=%s"
        % (time.time() - t0, usage.get("prompt_tokens"), det.get("cached_tokens"), det.get("created_cache_tokens")),
        flush=True,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
